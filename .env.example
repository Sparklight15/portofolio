# Salin file ini menjadi .env.local, lalu isi nilainya.
# Jangan pernah commit .env.local atau nilai rahasia asli.

# --- Admin (M1: auth) ---
# Username untuk login di /admin/login
ADMIN_USERNAME=
# Hash bcrypt password admin. Buat dengan: node scripts/buat-kredensial.mjs
# Di .env.local, setiap tanda $ harus ditulis \$ (script sudah menyediakannya).
# Di Vercel, tempel mentah tanpa backslash.
ADMIN_PASSWORD_HASH=
# String acak 64 karakter untuk menandatangani cookie sesi (dibuat oleh script yang sama)
SESSION_SECRET=